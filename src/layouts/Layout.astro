---
import 'lenis/dist/lenis.css';
import '../styles/global.css';
import LenisScroll from '../components/LenisScroll.svelte';
import Preloader from '../components/Preloader.svelte';

interface Props {
  title?: string;
  enableLenis?: boolean;
}

const { title = "Shang Yun 尚韵 — Hadiah Imlek", enableLenis = true } = Astro.props;
---

<!DOCTYPE html>
<html lang="id" class="ld" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <script is:inline>
      (function() {
        try {
          var saved = localStorage.getItem('shangyun.theme.v1');
          var theme = saved || (window.matchMedia && window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
          document.documentElement.setAttribute('data-theme', theme);
          document.documentElement.style.colorScheme = theme;
        } catch (e) {}
      })();
    </script>
    <noscript>
      <style>
        html.ld { overflow: auto !important; }
        #loader { display: none !important; }
      </style>
    </noscript>
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;1,500&family=Jost:wght@300;400;500;600&family=Ma+Shan+Zheng&display=swap"
    />
  </head>
  <body>
    <!-- Luxury Preloader Animation (Page entrance & reload) -->
    <Preloader client:load />

    <!-- Hidden SVG filter for Chinese ink effect -->
    <svg width="0" height="0" style="position:absolute" aria-hidden="true">
      <filter id="ink" x="-20%" y="-20%" width="140%" height="140%">
        <feTurbulence type="fractalNoise" baseFrequency=".011" numOctaves="4" seed="7" result="n" />
        <feDisplacementMap in="SourceGraphic" in2="n" scale="70" />
        <feGaussianBlur stdDeviation="1.2" />
      </filter>
    </svg>

    <!-- Lenis Smooth Scrolling Engine (Only for pages requiring smooth scrolling) -->
    {enableLenis && <LenisScroll client:load />}

    <slot />
  </body>
</html>
